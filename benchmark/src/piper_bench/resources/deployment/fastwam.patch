+"""Small real Wan/ActionDiT models exercise the joint training path on CPU."""
+import copy
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+from hydra import compose, initialize_config_dir
+from omegaconf import OmegaConf
+from torch import nn
+
+from fastwam.models.wan22.action_dit import ActionDiT
+from fastwam.models.wan22.fastwam import FastWAM
+from fastwam.models.wan22.lora import LoRALinear, inject_video_lora, is_adapter_key
+from fastwam.models.wan22.mot import MoT
+from fastwam.models.wan22.wan_video_dit import WanVideoDiT
+from fastwam.trainer import Wan22Trainer
+
+
+@pytest.fixture
+def model():
+    torch.manual_seed(42)
+    torch.set_num_threads(2)
+    common = dict(text_dim=16, freq_dim=16, eps=1e-6, num_heads=2,
+                  attn_head_dim=12, num_layers=2)
+    video = WanVideoDiT(hidden_dim=32, in_dim=4, out_dim=4, ffn_dim=64,
+                        patch_size=(1, 2, 2), has_image_input=False,
+                        seperated_timestep=True, **common)
+    action = ActionDiT(hidden_dim=16, action_dim=7, ffn_dim=32, **common)
+    return FastWAM(video, action, MoT({"video": video, "action": action}),
+                   vae=nn.Linear(1, 1), text_encoder=nn.Linear(1, 1),
+                   text_dim=16, proprio_dim=8)
+
+
+@pytest.fixture
+def inputs():
+    return dict(latents_video=torch.randn(2, 4, 2, 4, 4),
+                latents_action=torch.randn(2, 3, 7),
+                timestep_video=torch.tensor([0.3, 0.7]),
+                timestep_action=torch.tensor([0.2, 0.8]),
+                context=torch.randn(2, 4, 16),
+                context_mask=torch.ones(2, 4, dtype=torch.bool),
+                attention_mask=torch.ones(11, 11, dtype=torch.bool),
+                fuse_vae_embedding_in_latents=True)
+
+
+def enable(model):
+    model.enable_video_lora({"rank": 2, "alpha": 4})
+    Wan22Trainer._apply_dit_only_train_mode(model)
+
+
+def test_zero_update_and_mode_switches(model, inputs):
+    model.eval()
+    with torch.no_grad():
+        expected = model._joint_denoise_core(**inputs)
+    enable(model)
+    # The trainer invokes this after each validation phase as well as at startup.
+    for _ in range(2):
+        model.eval()
+        Wan22Trainer._apply_dit_only_train_mode(model)
+        for name, param in model.video_expert.named_parameters():
+            assert param.requires_grad == is_adapter_key(name), name
+        assert all(p.requires_grad for p in model.action_expert.parameters())
+        assert all(p.requires_grad for p in model.proprio_encoder.parameters())
+        assert not any(p.requires_grad for p in model.vae.parameters())
+        assert not any(p.requires_grad for p in model.text_encoder.parameters())
+    with torch.no_grad():
+        actual = model._joint_denoise_core(**inputs)
+    for before, after in zip(expected, actual):
+        torch.testing.assert_close(before, after, rtol=0, atol=0)
+
+
+def test_bfloat16_adapters_and_gradients(model, inputs):
+    model.to(dtype=torch.bfloat16)
+    enable(model)
+    inputs = {k: v.to(torch.bfloat16) if isinstance(v, torch.Tensor) and v.is_floating_point() else v
+              for k, v in inputs.items()}
+    video, action = model._joint_denoise_core(**inputs)
+    (video.float().square().mean() + action.float().square().mean()).backward()
+    for name, param in model.video_expert.named_parameters():
+        if is_adapter_key(name):
+            assert param.dtype == torch.bfloat16
+            assert param.grad is not None and torch.isfinite(param.grad).all()
+    assert model.action_expert.head.weight.grad.abs().sum() > 0
+
+
+@pytest.mark.parametrize("compiled", [False, True])
+def test_joint_backward_and_optimizer_step(model, inputs, compiled, monkeypatch):
+    enable(model)
+    if compiled:
+        # Exercise the real full-graph MoT branch without requiring a GPU compiler.
+        original_compile = torch.compile
+        monkeypatch.setattr(torch, "compile", lambda fn, **kw: original_compile(fn, backend="eager", **kw))
+        model.mot.compile_training_layers = True
+    frozen = {n: p.detach().clone() for n, p in model.video_expert.named_parameters()
+              if not p.requires_grad}
+    action_before = {n: p.detach().clone() for n, p in model.action_expert.named_parameters()}
+    optimizer = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=0.01)
+    for _ in range(2):
+        optimizer.zero_grad(set_to_none=True)
+        video, action = model._joint_denoise_core(**inputs)
+        (video.square().mean() + action.square().mean()).backward()
+        for name, p in model.action_expert.named_parameters():
+            assert p.grad is not None and torch.isfinite(p.grad).all(), name
+        for name, p in model.video_expert.named_parameters():
+            if is_adapter_key(name):
+                assert p.grad is not None and torch.isfinite(p.grad).all(), name
+            else:
+                assert p.grad is None, name
+        optimizer.step()
+    for name, p in model.video_expert.named_parameters():
+        if name in frozen:
+            assert torch.equal(p, frozen[name]), name
+        else:
+            assert p.grad.abs().sum() > 0, name
+    assert all(not torch.equal(p, action_before[n]) for n, p in model.action_expert.named_parameters())
+    if compiled:
+        assert hasattr(model.mot, "_compiled_joint_layer")
+
