+def test_compact_checkpoint_roundtrip(model, inputs, tmp_path):
+    restored = copy.deepcopy(model)
+    enable(model)
+    enable(restored)
+    optimizer = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=0.01)
+    video, action = model._joint_denoise_core(**inputs)
+    (video.square().mean() + action.square().mean()).backward()
+    optimizer.step()
+    path = tmp_path / "lora.pt"
+    model.save_checkpoint(path, optimizer=optimizer, step=17)
+    payload = torch.load(path, weights_only=True)
+    assert payload["step"] == 17
+    assert payload["video_lora"]["rank"] == 2
+    video_keys = [k for k in payload["mot"] if k.startswith("mixtures.video.")]
+    assert video_keys and all(is_adapter_key(k) for k in video_keys)
+    assert {k.removeprefix("mixtures.action.") for k in payload["mot"] if k.startswith("mixtures.action.")} == set(model.action_expert.state_dict())
+    restored_optimizer = torch.optim.AdamW([p for p in restored.parameters() if p.requires_grad], lr=0.01)
+    restored.load_checkpoint(path, optimizer=restored_optimizer)
+    for a, b in zip(model._joint_denoise_core(**inputs), restored._joint_denoise_core(**inputs)):
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+    for a, b in zip(model.proprio_encoder.parameters(), restored.proprio_encoder.parameters()):
+        assert torch.equal(a, b)
+    assert len(restored_optimizer.state) == len(optimizer.state) > 0
+    missing = next(k for k in payload["mot"] if k.startswith("mixtures.action."))
+    del payload["mot"][missing]
+    torch.save(payload, path)
+    with pytest.raises(ValueError, match="key mismatch"):
+        restored.load_checkpoint(path)
