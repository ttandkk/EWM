+@pytest.mark.parametrize("compiled", [False, True])
+def test_joint_checkpointing_matches_outputs_and_all_trainable_gradients(model, inputs, compiled, monkeypatch):
+    enable(model)
+    reference = copy.deepcopy(model)
+    model.video_expert.use_gradient_checkpointing = True
+    model.action_expert.use_gradient_checkpointing = True
+    model.mot = MoT({"video": model.video_expert, "action": model.action_expert},
+                    mot_checkpoint_mixed_attn=True)
+    if compiled:
+        original = torch.compile
+        monkeypatch.setattr(torch, "compile", lambda fn, **kw: original(fn, backend="eager", **kw))
+        model.mot.compile_training_layers = True
+    proprio = torch.randn(inputs["context"].shape[0], 8)
+    def forward_with_proprio(m):
+        context = torch.cat([inputs["context"], m.proprio_encoder(proprio).unsqueeze(1)], dim=1)
+        mask = torch.ones(context.shape[:2], dtype=torch.bool)
+        return m._joint_denoise_core(**{**inputs, "context": context, "context_mask": mask})
+    expected = forward_with_proprio(reference)
+    actual = forward_with_proprio(model)
+    for a, b in zip(actual, expected):
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+    sum(x.square().mean() for x in actual).backward()
+    sum(x.square().mean() for x in expected).backward()
+    actual_params = dict(model.named_parameters())
+    for name, p in reference.named_parameters():
+        q = actual_params[name]
+        if p.requires_grad:
+            assert p.grad is not None and q.grad is not None, name
+            torch.testing.assert_close(q.grad, p.grad, rtol=1e-5, atol=1e-6)
+        else:
+            assert q.grad is None, name
