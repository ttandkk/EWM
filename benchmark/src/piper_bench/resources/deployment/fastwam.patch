+def test_trainer_optimizer_and_full_state_resume(model, inputs, tmp_path, monkeypatch):
+    from accelerate import Accelerator
+    from fastwam import trainer as trainer_module
+
+    accelerator = Accelerator(cpu=True, mixed_precision="no")
+
+    class CPUAccelerator:
+        # The trainer's existing startup log assumes a DeepSpeed plugin. Keep
+        # actual CPU Accelerate prepare/save/load, shim only that log metadata.
+        state = SimpleNamespace(deepspeed_plugin=SimpleNamespace(deepspeed_config={}))
+
+        def __getattr__(self, name):
+            return getattr(accelerator, name)
+
+    monkeypatch.setattr(trainer_module, "Accelerator", lambda **kwargs: CPUAccelerator())
+    config_dir = str(Path(__file__).resolve().parents[1] / "configs")
+    with initialize_config_dir(version_base=None, config_dir=config_dir):
+        cfg = compose(config_name="train", overrides=["task=libero_uncond_2cam224_1e-4", "model=fastwam_lora"])
+    cfg.output_dir = str(tmp_path / "run")
+    cfg.mixed_precision = "no"
+    cfg.num_workers = 0
+    cfg.max_steps = 2
+    cfg.learning_rate = 0.01
+    enable(model)
+    trainer = Wan22Trainer(model, [torch.zeros(1), torch.ones(1)], cfg=cfg)
+    optimized = {id(p) for group in trainer.optimizer.param_groups for p in group["params"]}
+    expected = {id(p) for p in model.parameters() if p.requires_grad}
+    assert optimized == expected
+    assert all(id(p) in optimized for p in model.action_expert.parameters())
+    assert all(id(p) not in optimized for n, p in model.video_expert.named_parameters() if not is_adapter_key(n))
+    video, action = model._joint_denoise_core(**inputs)
+    accelerator.backward(video.square().mean() + action.square().mean())
+    trainer.optimizer.step()
+    trainer.scheduler.step()
+    trainer.global_step = 1
+    trainer.batch_in_epoch = 1
+    trainer.optimizer.zero_grad(set_to_none=True)
+    saved_weights = copy.deepcopy(model.mot.state_dict())
+    saved_scheduler = copy.deepcopy(trainer.scheduler.state_dict())
+    saved_moment = next(iter(trainer.optimizer.state.values()))["exp_avg"].clone()
+    checkpoint = trainer.save_checkpoint()
+    with torch.no_grad():
+        model.action_expert.head.weight.zero_()
+        next(m for m in model.video_expert.modules() if isinstance(m, LoRALinear)).lora_B.zero_()
+        for state in trainer.optimizer.state.values():
+            state["exp_avg"].zero_()
+    trainer.scheduler.step()
+    trainer.global_step = 0
+    trainer.load_training_state(checkpoint["state_path"])
+    assert trainer.global_step == 1 and trainer.batch_in_epoch == 1
+    assert trainer.scheduler.state_dict() == saved_scheduler
+    assert torch.equal(next(iter(trainer.optimizer.state.values()))["exp_avg"], saved_moment)
+    assert all(torch.equal(v, saved_weights[k]) for k, v in model.mot.state_dict().items())
+    trainer._set_dit_only_train_mode()
+    assert all(p.requires_grad == is_adapter_key(n) for n, p in model.video_expert.named_parameters())
+    model.video_lora_config = {**model.video_lora_config, "alpha": 8.0}
+    with pytest.raises(ValueError, match="video_lora settings"):
+        trainer.load_training_state(checkpoint["state_path"])
+
