+++ b/tests/test_action_only.py
@@ -0,0 +1,137 @@
+"""Action-only training must match the causal joint policy without a Wan graph."""
+import copy
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+from hydra import compose, initialize_config_dir
+from omegaconf import OmegaConf
+
+from fastwam.trainer import Wan22Trainer
+from test_video_lora import model, inputs  # shared tiny real Wan/ActionDiT fixtures
+
+
+@pytest.fixture(autouse=True)
+def causal_video(model):
+    model.video_expert.video_attention_mask_mode = "first_frame_causal"
+
+
+def enable(model):
+    model.enable_action_only()
+    Wan22Trainer._apply_dit_only_train_mode(model)
+
+
+def test_matches_joint_action_outputs_and_gradients(model, inputs):
+    baseline = copy.deepcopy(model)
+    baseline.video_expert.requires_grad_(False)
+    inputs["attention_mask"] = baseline._build_mot_attention_mask(8, 3, 4, torch.device("cpu"))
+    _, expected = baseline._joint_denoise_core(**inputs)
+    expected.square().mean().backward()
+    enable(model)
+    actual = model._action_only_denoise_core(
+        inputs["latents_video"], inputs["latents_action"], inputs["timestep_action"],
+        inputs["context"], inputs["context_mask"],
+    )
+    actual.square().mean().backward()
+    torch.testing.assert_close(actual, expected, atol=1e-6, rtol=1e-5)
+    for (name, p), (_, ref) in zip(model.action_expert.named_parameters(), baseline.action_expert.named_parameters()):
+        assert p.grad is not None, name
+        torch.testing.assert_close(p.grad, ref.grad, atol=1e-6, rtol=1e-4)
+    assert all(p.grad is None for p in model.video_expert.parameters())
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_training_encodes_only_first_frame_and_updates_only_action(model, monkeypatch, dtype):
+    model.to(dtype=dtype)
+    # The tiny fixture records this explicitly, as production factories do.
+    model.torch_dtype = dtype
+    enable(model)
+    original_video = copy.deepcopy(model.video_expert.state_dict())
+    action_before = model.action_expert.head.weight.detach().clone()
+    calls = []
+
+    def encode(video, tiled=False):
+        calls.append(tuple(video.shape))
+        assert not torch.is_grad_enabled() or not video.requires_grad
+        return torch.randn(video.shape[0], 4, 1, 4, 4, dtype=dtype)
+
+    monkeypatch.setattr(model, "_encode_video_latents", encode)
+    # Forbidden paths catch an accidental return to joint video training.
+    monkeypatch.setattr(model.video_expert, "post", lambda *a: pytest.fail("video head must be unused"))
+    monkeypatch.setattr(model, "_compute_video_loss_per_sample", lambda *a, **k: pytest.fail("video loss must be unused"))
+    sample = dict(video=torch.randn(2, 3, 9, 16, 16), action=torch.randn(2, 3, 7),
+                  proprio=torch.randn(2, 1, 8), context=torch.randn(2, 4, 16),
+                  context_mask=torch.ones(2, 4, dtype=torch.bool),
+                  action_is_pad=torch.tensor([[False, False, True], [False, False, False]]))
+    optimizer = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=0.01)
+    loss, metrics = model.training_loss(sample)
+    loss.backward()
+    assert torch.isfinite(loss) and metrics["loss_video"] == 0
+    assert calls == [(2, 3, 1, 16, 16)]
+    assert model.proprio_encoder.weight.grad.abs().sum() > 0
+    assert all(p.grad is not None and torch.isfinite(p.grad).all() for p in model.action_expert.parameters())
+    assert all(p.grad is None for p in model.video_expert.parameters())
+    optimizer.step()
+    assert not torch.equal(action_before, model.action_expert.head.weight)
+    assert all(torch.equal(p, original_video[k]) for k, p in model.video_expert.state_dict().items())
+    for _ in range(2):
+        model.eval()
+        Wan22Trainer._apply_dit_only_train_mode(model)
+        assert not model.video_expert.training
+        assert not any(p.requires_grad for p in model.video_expert.parameters())
+        assert all(p.requires_grad for p in model.action_expert.parameters())
+
+
+def test_guards_and_full_weight_roundtrip(model, tmp_path):
+    dense = tmp_path / "dense.pt"
+    model.save_checkpoint(dense)
+    enable(model)
+    model.load_checkpoint(dense)  # Full exports keep a self-contained frozen base.
+    path = tmp_path / "action.pt"
+    model.save_checkpoint(path)
+    payload = torch.load(path, weights_only=True)
+    assert payload["training_mode"] == "action_only"
+    assert set(payload["mot"]) == set(model.mot.state_dict())
+    with torch.no_grad():
+        model.action_expert.head.weight.zero_()
+    model.load_checkpoint(path)
+    assert torch.equal(model.action_expert.head.weight, payload["mot"]["mixtures.action.head.weight"])
+    with pytest.raises(ValueError, match="mutually exclusive"):
+        model.enable_video_lora({"rank": 2})
+
+
+def test_preset_factory_and_early_guards(model, monkeypatch):
+    from fastwam import runtime
+    from fastwam.models.wan22.fastwam import FastWAM
+
+    with initialize_config_dir(version_base=None, config_dir=str(Path(__file__).resolve().parents[1] / "configs")):
+        cfg = compose(config_name="train", overrides=["task=libero_uncond_2cam224_1e-4", "model=fastwam_action_only"])
+    kwargs = OmegaConf.to_container(cfg.model, resolve=True)
+    kwargs.pop("_target_")
+    monkeypatch.setattr(FastWAM, "from_wan22_pretrained", lambda **kw: model)
+    assert runtime.create_fastwam(**kwargs, device="cpu").action_only
+    with pytest.raises(ValueError, match="mutually exclusive"):
+        runtime.create_fastwam(**{**kwargs, "video_lora": {"rank": 2}}, device="cpu")
+    with pytest.raises(ValueError, match="pretrained"):
+        runtime.create_fastwam(**{**kwargs, "skip_dit_load_from_pretrain": True}, device="cpu")
+    with pytest.raises(ValueError, match="positive"):
+        runtime.create_fastwam(**{**kwargs, "loss": {"lambda_video": 0, "lambda_action": 0}}, device="cpu")
+
+
+def test_full_state_mode_metadata_and_resume_guard(model, tmp_path):
+    enable(model)
+    trainer = Wan22Trainer.__new__(Wan22Trainer)
+    trainer.model = model
+    trainer.global_step, trainer.epoch, trainer.batch_in_epoch = 3, 0, 3
+    trainer.accelerator = SimpleNamespace(
+        unwrap_model=lambda m: m,
+        load_state=lambda **kw: pytest.fail("mismatched mode must fail before loading state"),
+    )
+    trainer._save_trainer_state(str(tmp_path))
+    payload = json.loads((tmp_path / "trainer_state.json").read_text())
+    assert payload["action_only"] is True
+    model.action_only = False
+    with pytest.raises(ValueError, match="action_only mode"):
+        trainer.load_training_state(str(tmp_path))
