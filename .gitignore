# Source release: keep code, configs, locks, patches, tests, docs and small assets.
# Ignoring a path never deletes its local files or untracks existing Git entries.

# Local datasets, pretrained weights, checkpoints and installed runtimes.
/datasets/
/pretrained/
/ckpts/
/checkpoints/
/weights/
/envs/
/isaacsim601/

# Local legacy trees are not part of the current source release.
/migration/
/Event-DataCollection/
/assets/
/archive/

# External sources and patches are pinned in benchmark's deployment resources.
/third_party/
/FastWAM/
/Isaac-GR00T/
/OpenWAM/third_party/
/Event-DataCollection/third_party/

# Local experiments, frozen job snapshots and evaluation results.
/tmp/
/logs/
/results/
outputs/
wandb/
runs/
lightning_logs/
tensorboard/
.hydra/
.dvs_tmp/
events.out.tfevents.*
slurm-*.out
slurm-*.err
*.log

